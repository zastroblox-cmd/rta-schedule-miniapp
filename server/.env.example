# Telegram bot token from BotFather. Keep this value secret.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string from your database provider.
# Prefer a pooled connection string for hosted deployments.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://zastroblox-cmd.github.io,http://localhost:8000,http://127.0.0.1:8000

# Maximum age of Telegram Web App initData, in seconds.
TELEGRAM_INIT_DATA_MAX_AGE=86400
